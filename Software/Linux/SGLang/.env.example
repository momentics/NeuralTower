# Конфигурация SGLang
# Скопируйте в .env и измените значения

# Путь к хранилищу моделей
MODELS_PATH=/opt/llm/models

# Путь к NVMe для HiCache L3 (файловый бэкенд)
KV_CACHE_PATH=/nvme/sglang_kv_cache

# Устройства GPU (через запятую)
CUDA_VISIBLE_DEVICES=0,1,2,3

# Размер тензорного параллелизма
TP_SIZE=2

# Размер конвейерного параллелизма
PP_SIZE=2

# Путь к модели (по умолчанию: Qwen3.6-27B-Instruct)
# Для MTP-моделей (например Qwen3.6-30B-A3B) установите MODEL_PATH на MTP-модель,
# закомментируйте EAGLE_DRAFT_MODEL_PATH и настройте параметры спекулятивного декодирования в docker-compose.yml:
#   --speculative-num-steps 1 --speculative-eagle-topk 1 --speculative-num-draft-tokens 2
MODEL_PATH=/models/Qwen3.6-27B-Instruct

# Путь к модели-черновику EAGLE (закомментируйте для MTP-моделей — они имеют встроенные MTP-головы)
EAGLE_DRAFT_MODEL_PATH=/models/EAGLE-Qwen3.6-27B-Instruct

# Доля памяти для весов модели и пула KV-кэша (0.0–1.0)
# V100 32 ГБ: Qwen3.6-27B FP16 ~13,5 ГБ/GPU при TP=2. Значение 0.50 оставляет запас для дерева черновиков EAGLE.
MEM_FRACTION_STATIC=0.50

# Максимальный размер пакета CUDA-графа (меньше — меньше видеопамяти на графы, больше запаса на активации)
# ВАЖНО для MTP: значение должно быть кратно (num_speculative_tokens + 1)
# Для MTP с --speculative-num-draft-tokens 2 используйте 4, 8, 12 и т. д.
CUDA_GRAPH_MAX_BS=4

# Объём HiCache L2 в оперативной памяти на каждый ранг (ГБ). При TP=2, PP=2 → 4 ранга, итого HICACHE_SIZE_GB × 4
HICACHE_SIZE_GB=30

# Пароль администратора Grafana
GRAFANA_ADMIN_PASSWORD=change_me
