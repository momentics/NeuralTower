# SGLang Configuration
# Скопируйте в .env и измените значения

# Путь к хранилищу моделей
MODELS_PATH=/opt/llm/models

# Путь к хранилищу KV кэша
KV_CACHE_PATH=/mnt/optane_u2/sglang_kv_cache

# GPU устройства (через запятую)
CUDA_VISIBLE_DEVICES=0,1,2,3

# Размер тензорного параллелизма
TP_SIZE=2

# Размер пайплайн параллелизма
PP_SIZE=2

# Доля памяти для статических моделей (0.0-1.0)
MEM_FRACTION_FAST=0.50
MEM_FRACTION_HEAVY=0.40

# Ограничение памяти CPU для HiCache (ГБ)
HICACHE_CPU_MEMORY_LIMIT_GB=48

# Пароль админа Grafana
GRAFANA_ADMIN_PASSWORD=change_me