# --- ИНФРАСТРУКТУРА БЕЗОПАСНОСТИ КЛИЕНТСКИХ ДАННЫХ ---
CONFIG_SECURITY_WRITABLE_HOOKS=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y

# --- РАНДОМИЗАЦИЯ И ЗАЩИТА АДРЕСНОГО ПРОСТРАНСТВА (KASLR) ---
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_PAGESPAN=y

# --- ПЛАГИНЫ КОМПИЛЯТОРА GCC ДЛЯ ИЗОЛЯЦИИ СТЭКА ---
CONFIG_GCC_PLUGINS=y
CONFIG_GCC_PLUGIN_STRUCTLEAK=y
CONFIG_GCC_PLUGIN_STRUCTLEAK_BYREF_ALL=y
CONFIG_INIT_STACK_ALL_ZERO=y

# --- СОХРАНЕНИЕ ПРОФИЛЯ ПАРАЛЛЕЛИЗМА И ШИНЫ ПАМЯТИ ---
CONFIG_NUMA=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
CONFIG_PCI_P2PDMA=y
CONFIG_IOSCHED_NONE=y
